# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (PostgreSQL):
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobsearch"
# Railway: set automatically when you add a Postgres plugin — no need to set this manually

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCAN_INTERVAL_HOURS=6

# ─── AI (optional — mock mode works without a key) ────────────────────────────
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# For local models (Ollama / LM Studio):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# OPENAI_API_KEY=ollama

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins beyond localhost.
# Set this to your GitHub Pages URL in Railway:
# ALLOWED_ORIGINS=https://yourusername.github.io

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorised redirect URI must be: <BACKEND_URL>/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Full public URL of this backend (used to build the OAuth callback URL)
BACKEND_URL=http://localhost:3001

# Full public URL of the frontend (users are redirected here after login)
FRONTEND_URL=http://localhost:5173
