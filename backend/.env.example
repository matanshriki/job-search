# Database (SQLite file path)
DATABASE_URL="file:./data/job-search.db"

# Server
PORT=3001
NODE_ENV=development

# AI Provider (optional - app works without it, agents will use mock mode)
# Supports any OpenAI-compatible API
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# Alternative: use a local model via Ollama or LM Studio
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# OPENAI_API_KEY=ollama

# Disable public CORS proxies for career page scanning (default: false)
DISABLE_PUBLIC_CORS_PROXY=false

# Allow insecure TLS for career page dev proxy fetch
JOB_SEARCH_ALLOW_INSECURE_TLS=false

# Scheduler (set to false to disable background jobs)
SCHEDULER_ENABLED=true
SCAN_INTERVAL_HOURS=6
